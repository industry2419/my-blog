---
import WidgetLayout from "@components/molecules/WidgetLayout.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import stylus from "stylus";
import type { MusicWidget } from "@/types/sidebarConfig";
import MusicSidebarClient from "./MusicSidebarClient.svelte";
import { resolveMusicPlayerData } from "./musicPlayerData";
import { musicSidebarStylus } from "./musicSidebarStyles";

interface Props {
	class?: string;
	style?: string;
	widget?: MusicWidget;
}

const className = Astro.props.class;
const style = Astro.props.style;
const player = await resolveMusicPlayerData();
const musicSidebarStyles = player
	? await new Promise<string>((resolve, reject) => {
			stylus.render(musicSidebarStylus, (error, css) => {
				if (error) reject(error);
				else resolve(css);
			});
		})
	: null;
---

{player && musicSidebarStyles && (
	<>
		<style is:inline set:html={musicSidebarStyles}></style>
		<WidgetLayout
			name={i18n(I18nKey.musicPlayerTitle)}
			id="sidebar-music-player"
			class={className}
			style={style}
		>
			<MusicSidebarClient
				client:load
				options={player.options}
				labels={player.labels}
			/>
		</WidgetLayout>
	</>
)}
