---
import BannerStage from "@components/organisms/BannerStage.astro";
import CategoryBar from "@components/organisms/CategoryBar.astro";
import ContextMenu from "@components/organisms/ContextMenu.svelte";
import FloatingControls from "@components/organisms/FloatingControls.astro";
import Footer from "@components/organisms/Footer.astro";
import MusicCapsule from "@components/organisms/music/MusicCapsule.astro";
import RouteProgress from "@components/organisms/RouteProgress.svelte";
import SideBar from "@components/organisms/SideBar.astro";
import SiteNavigationDrawer from "@components/organisms/SiteNavigationDrawer.svelte";
import TopAppBar from "@components/organisms/TopAppBar.astro";
import {
	generateGridClasses,
	generateMainContentClasses,
	generatePrimarySidebarClasses,
	generateSecondarySidebarClasses,
	getResponsiveSidebarConfig,
	isDualColumn,
} from "@utils/responsive-utils";
import type { MarkdownHeading } from "astro";
import { contextMenuConfig, fabConfig, sidebarConfig } from "@/config";
import type { SidebarPage } from "@/types/sidebarConfig";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	ogImage?: string;
	description?: string;
	/** Banner 可选日期，使用 YYYY-MM-DD 等可直接写入 time[datetime] 的值。 */
	bannerDate?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	/** 文章页所属分类名，透传给 CategoryBar 做弱高亮 */
	postCategory?: string;
	/** 当前页面标识符（SidebarPage），透传给 SideBar 做 pages 过滤，并输出到
	 *  #swup-container 的 data-current-page——Swup 替换容器时同步该属性，
	 *  侧栏据此在站内导航后重新过滤 */
	page?: SidebarPage;
	hasComments?: boolean;
}

const {
	title,
	banner,
	ogImage,
	description,
	bannerDate,
	lang,
	setOGTypeArticle,
	headings = [],
	postCategory,
	page,
	hasComments,
} = Astro.props;

// 响应式侧栏配置（数据驱动布局）
const sidebarResponsive = getResponsiveSidebarConfig();
const gridClasses = generateGridClasses(sidebarResponsive);
const sidebarClasses = generatePrimarySidebarClasses(sidebarResponsive);
const secondarySidebarClasses =
	generateSecondarySidebarClasses(sidebarResponsive);
const mainContentClasses = generateMainContentClasses(sidebarResponsive);

// Swup container fallback: `containers` declares ["main", "#toc"], but `#toc`
// is emitted only by the TOC sidebar widget (enabled by default; its `pages`
// filter merely hides wrappers per page — they still carry `#toc` in the
// DOM). When it is missing, Swup reports a container mismatch and every
// in-site navigation falls back to a full page load.
//
// Whether the widget can provide `#toc` mirrors SideBar's own render path:
// the sidebar master switch must be on, and the widget must reach a rendered
// column — the primary instance always renders it, while a secondary-column
// widget needs the dual arrangement (the primary instance filters it out,
// and the secondary instance is not rendered at all under "single").
// Otherwise render one inert fallback container here.
const tocWidget = sidebarConfig.components.find(
	(widget) => widget.type === "toc" && widget.enable,
);
const hasTocWidget =
	sidebarConfig.enable &&
	tocWidget !== undefined &&
	((tocWidget.column ?? "primary") === "primary" ||
		isDualColumn(sidebarResponsive));
---

<Layout title={title} banner={banner} ogImage={ogImage} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} page={page}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<header id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <TopAppBar></TopAppBar>
    </div>
</header>

<!-- Banner -->
<BannerStage page={page} title={title} description={description} date={bannerDate} />

<!-- Main content -->
<div id="main-layout" class="absolute w-full z-30 pointer-events-none">
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
		<div id="main-grid" class:list={["transition duration-[var(--m3e-duration-long)] w-full left-0 right-0 grid grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4", gridClasses]}>
			<SideBar class={sidebarClasses} currentPage={page} headings={headings}></SideBar>
			{isDualColumn(sidebarResponsive) && (
				<SideBar id="sidebar-secondary" column="secondary" class={secondarySidebarClasses} currentPage={page} headings={headings}></SideBar>
			)}

            <!-- 主内容列：分类导航栏静态渲染（位于 Swup 容器外），
                 页面切换时保持固定不重渲染；仅内容区随导航替换 -->
            <div id="main-content-column" class={mainContentClasses.replace("transition-swup-fade", "").trim()}>
                <CategoryBar currentPostCategory={postCategory}></CategoryBar>
                <main
                    id="swup-container"
                    data-current-post-category={postCategory || ""}
                    data-current-page={page}
                    data-has-comments={hasComments ? "true" : "false"}
                    data-banner-title={title || ""}
                    data-banner-description={description || ""}
                    data-banner-date={bannerDate || ""}
                    class="transition-swup-fade"
                >
                    <div id="content-wrapper" class="onload-animation">
                        <!-- the overflow-hidden here prevent long text break the layout-->
                        <!-- make id different from windows.swup global property -->
                        <slot></slot>
                        <div class="footer col-span-2 onload-animation hidden lg:block">
                            <Footer></Footer>
                        </div>
                    </div>
                </main>
            </div>

            {!hasTocWidget && (
                <div id="toc" hidden aria-hidden="true" data-swup-toc-fallback></div>
            )}

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <FloatingControls page={page} headings={headings} hasComments={hasComments} />
        <!-- 音乐胶囊：仅 solo 布局（非主页）显示，与侧栏播放器共用同一个
             音乐运行时单例，Swup 导航期间播放不中断 -->
        <div
            class:list={[
                "music-capsule-shell",
                { "music-capsule-shell--right": fabConfig.align === "start" },
            ]}
            style={`--capsule-bottom: ${fabConfig.offset?.bottom ?? "var(--m3e-space-8)"}; --capsule-inline-offset: ${fabConfig.offset?.right ?? "var(--m3e-space-6)"}`}
        >
            <MusicCapsule />
        </div>
        <RouteProgress client:load />
    </div>
</div>

<SiteNavigationDrawer client:load />
{contextMenuConfig.enable && (
	<ContextMenu
		actions={contextMenuConfig.actions}
		pages={contextMenuConfig.pages}
		client:load
	/>
)}

</Layout>

<!--
  solo 布局（除主页外的所有页面）：
  两侧栏属于 Swup 持久壳，导航时不重渲染，因此用 #swup-container 上的
  data-current-page（Swup 替换容器时同步该属性）经 :has() 驱动纯 CSS 切换，
  与直接加载、站内导航两种入口保持一致。
-->
<style is:global lang="stylus">
/* 胶囊外框：fixed 定位脱离网格；默认不显示，solo 布局才出现 */
.music-capsule-shell
	position: fixed
	bottom: var(--capsule-bottom, var(--m3e-space-8))
	left: var(--capsule-inline-offset, var(--m3e-space-6))
	z-index: 44
	display: none
	width: fit-content
	max-width: unquote("calc(100vw - var(--m3e-space-6) * 2)")
	pointer-events: none

	/* FAB 靠左时胶囊换到右侧，保持两者不在同一角 */
	&--right
		right: var(--capsule-inline-offset, var(--m3e-space-6))
		left: auto

/* 歌词条固定在视口底部，会盖住页面末段内容；展开时由 #main-layout 预留等高的
   底部空间，滚到最底部也能完整读到 footer。--music-lyrics-inset 由
   MusicCapsuleClient 按歌词条实测高度写入，未展开或胶囊隐藏时为 0。 */
#main-layout:has(#swup-container:not([data-current-page="home"])):has(.music-capsule__lyrics-bar)
	padding-bottom: unquote("calc(var(--music-lyrics-inset, 0px) + var(--m3e-space-4))")

#main-layout:has(#swup-container:not([data-current-page="home"]))
	#sidebar
	#sidebar-secondary
		display: none

	#main-grid
		grid-template-columns: minmax(0, 1fr)

	/* 单列网格里 footer 原本 col-span-2，会创建隐式第二列，显式拉满 */
	#main-grid > .footer
		grid-column: 1 / -1

	/* 两栏隐藏后不再扣减侧栏列宽，中间内容用更宽的阅读上限：
	   常规页框（85rem）直接铺满，dual 页框（96rem）以 72rem 居中，
	   既比主页中间列（dual xl 约 59rem）宽松，也不至于行长过宽难以跟读。 */
	#main-content-column
		width: 100%
		max-width: 72rem
		grid-column: 1 / -1
		justify-self: center

	.music-capsule-shell
		display: block
</style>
