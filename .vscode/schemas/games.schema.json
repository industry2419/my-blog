{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "games configuration override",
  "description": "Shirone games config schema generated from @/types/gamesConfig.GamesConfig",
  "type": "object",
  "properties": {
    "enable": {
      "type": "boolean",
      "description": "页面总开关；关闭后隐藏导航入口并将 /games/ 重定向到 404。"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "稳定标识，供游戏引用与筛选。"
          },
          "label": {
            "type": "string",
            "description": "用户可编辑的分类名称。"
          },
          "icon": {
            "anyOf": [
              {},
              {
                "type": "string"
              }
            ],
            "description": "Iconify 图标名（筛选 Chip 前置图标）。"
          },
          "description": {
            "anyOf": [
              {},
              {
                "type": "string"
              }
            ],
            "description": "可选的分类说明。"
          }
        },
        "additionalProperties": false
      },
      "description": "游戏分类列表（决定 Chips 渲染顺序）。"
    },
    "disabledIds": {
      "anyOf": [
        {},
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "可选被禁用的游戏 ID 列表。"
    },
    "disabledKeys": {
      "anyOf": [
        {},
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "兼容通用 disabledKeys 别名。"
    },
    "items": {
      "anyOf": [
        {},
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "enable": {
                "anyOf": [
                  {},
                  {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  },
                  {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                ],
                "description": "可选独立开关；关闭后不参与渲染与计数（优先使用 config.disabledIds）。"
              },
              "id": {
                "type": "string",
                "description": "稳定标识（URL 片段 / 测试选择器）。"
              },
              "name": {
                "type": "string",
                "description": "游戏名称。"
              },
              "developer": {
                "type": "string",
                "description": "开发商/工作室（如 miHoYo, FromSoftware）。"
              },
              "category": {
                "type": "string",
                "description": "所属分类（对应 GameCategory.key）。"
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "wishlist"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "playing"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "completed"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "backlog"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "quit"
                    ]
                  }
                ],
                "description": "游玩状态。"
              },
              "cover": {
                "anyOf": [
                  {},
                  {
                    "type": "string"
                  }
                ],
                "description": "横屏封面图（站内绝对路径，建议 16:9 或更宽的本地 WebP/AVIF）。"
              },
              "icon": {
                "anyOf": [
                  {},
                  {
                    "type": "string"
                  }
                ],
                "description": "无封面时使用的 Iconify 图标。"
              },
              "rating": {
                "anyOf": [
                  {},
                  {
                    "type": "number"
                  }
                ],
                "description": "评分（0–5，支持 0.5 步进）。"
              },
              "hours": {
                "anyOf": [
                  {},
                  {
                    "type": "number"
                  }
                ],
                "description": "已游玩时长（小时）。"
              },
              "platform": {
                "anyOf": [
                  {},
                  {
                    "type": "string"
                  }
                ],
                "description": "平台（如 PC / PlayStation / Switch / Mobile）。"
              },
              "year": {
                "anyOf": [
                  {},
                  {
                    "type": "string"
                  }
                ],
                "description": "发行年份（自由格式，如 \"2024\"）。"
              },
              "tags": {
                "anyOf": [
                  {},
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "类型标签（渲染为卡片上的 chips）。"
              },
              "description": {
                "type": "string",
                "description": "游戏简评/感受。"
              },
              "link": {
                "anyOf": [
                  {},
                  {
                    "type": "string"
                  }
                ],
                "description": "商店页、官网或评测链接。"
              },
              "featured": {
                "anyOf": [
                  {},
                  {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  },
                  {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                ],
                "description": "特别推荐标记（渲染 Featured 徽章）。"
              },
              "credential": {
                "anyOf": [
                  {},
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "anyOf": [
                          {},
                          {
                            "type": "number"
                          }
                        ],
                        "description": "账号等级（冒险等阶 / 开拓等级 / 绳网等级）"
                      },
                      "levelLabel": {
                        "anyOf": [
                          {},
                          {
                            "type": "string"
                          }
                        ],
                        "description": "等级本地化标签（如「冒险等阶」），缺省用 i18n 文案"
                      },
                      "achievements": {
                        "anyOf": [
                          {},
                          {
                            "type": "object",
                            "properties": {
                              "done": {
                                "type": "number"
                              },
                              "total": {
                                "anyOf": [
                                  {},
                                  {
                                    "type": "number"
                                  }
                                ]
                              }
                            },
                            "additionalProperties": false
                          }
                        ],
                        "description": "成就完成数（部分接口不提供总数，此时只显示完成数）"
                      },
                      "exploration": {
                        "anyOf": [
                          {},
                          {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "label": {
                                  "type": "string"
                                },
                                "percent": {
                                  "type": "number"
                                }
                              },
                              "additionalProperties": false
                            }
                          }
                        ],
                        "description": "探索进度（可多项）"
                      },
                      "challenge": {
                        "anyOf": [
                          {},
                          {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number"
                              },
                              "max": {
                                "anyOf": [
                                  {},
                                  {
                                    "type": "number"
                                  }
                                ]
                              },
                              "unit": {
                                "anyOf": [
                                  {},
                                  {
                                    "type": "string"
                                  }
                                ]
                              },
                              "season": {
                                "anyOf": [
                                  {},
                                  {
                                    "type": "string"
                                  }
                                ]
                              }
                            },
                            "additionalProperties": false
                          }
                        ],
                        "description": "深渊 / 高难战绩"
                      },
                      "extra": {
                        "anyOf": [
                          {},
                          {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "key": {
                                  "type": "string"
                                },
                                "label": {
                                  "anyOf": [
                                    {},
                                    {
                                      "type": "string"
                                    }
                                  ]
                                },
                                "value": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "number"
                                    }
                                  ]
                                }
                              },
                              "additionalProperties": false
                            }
                          }
                        ],
                        "description": "其余可证明资历的指标"
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "手填资历数据（快照缺失或未启用同步时的兜底）。"
              }
            },
            "additionalProperties": false
          }
        }
      ],
      "description": "可选自定义数据（向后兼容；默认读取 src/data/games.ts）。"
    },
    "source": {
      "anyOf": [
        {},
        {
          "type": "object",
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "local"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "snapshot"
                  ]
                }
              ]
            },
            "provider": {
              "anyOf": [
                {},
                {
                  "type": "string",
                  "enum": [
                    "enka"
                  ]
                }
              ]
            },
            "file": {
              "anyOf": [
                {},
                {
                  "type": "string"
                }
              ],
              "description": "快照文件名（限定在 snapshot.directory 内）。"
            },
            "fetchOnDev": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "资历数据来源（缺省 local，零外部依赖）。"
    },
    "fallback": {
      "anyOf": [
        {},
        {
          "type": "object",
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "local"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "empty"
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "快照不可用时的降级策略。"
    },
    "providers": {
      "anyOf": [
        {},
        {
          "type": "object",
          "properties": {
            "enka": {
              "anyOf": [
                {},
                {
                  "type": "object",
                  "properties": {
                    "enable": {
                      "type": "boolean",
                      "description": "是否启用 Enka 同步"
                    },
                    "games": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "gameId": {
                            "type": "string",
                            "description": "对应 GameItem.id"
                          },
                          "provider": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "genshin"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "starrail"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "zenless"
                                ]
                              }
                            ],
                            "description": "游戏标识"
                          },
                          "uid": {
                            "type": "string",
                            "description": "游戏内 UID"
                          }
                        },
                        "additionalProperties": false
                      },
                      "description": "需要同步的账号列表"
                    },
                    "request": {
                      "anyOf": [
                        {},
                        {
                          "type": "object",
                          "properties": {
                            "minDelayMs": {
                              "anyOf": [
                                {},
                                {
                                  "type": "number"
                                }
                              ]
                            },
                            "timeoutMs": {
                              "anyOf": [
                                {},
                                {
                                  "type": "number"
                                }
                              ]
                            }
                          },
                          "additionalProperties": false
                        }
                      ],
                      "description": "可选请求调优"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "steam": {
              "anyOf": [
                {},
                {
                  "type": "object",
                  "properties": {
                    "enable": {
                      "type": "boolean",
                      "description": "是否启用 Steam 游戏库同步（默认 false）。"
                    },
                    "apiKeyEnv": {
                      "anyOf": [
                        {},
                        {
                          "type": "string"
                        }
                      ],
                      "description": "API Key 所在环境变量名（默认 STEAM_API_KEY）。"
                    },
                    "steamIdEnv": {
                      "anyOf": [
                        {},
                        {
                          "type": "string"
                        }
                      ],
                      "description": "SteamID64 所在环境变量名（默认 STEAM_ID）。"
                    },
                    "topGames": {
                      "anyOf": [
                        {},
                        {
                          "type": "number"
                        }
                      ],
                      "description": "站内最多展示的游戏数（1–200，默认 200）；同步脚本始终写入全部游戏。"
                    },
                    "achievementLimit": {
                      "anyOf": [
                        {},
                        {
                          "type": "number"
                        }
                      ],
                      "description": "为前 N 款游戏拉取成就完成度（0 关闭，默认全部）。"
                    },
                    "downloadCovers": {
                      "anyOf": [
                        {},
                        {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        }
                      ],
                      "description": "是否下载商店头图作为站内封面（默认 true）。"
                    },
                    "localPlaytime": {
                      "anyOf": [
                        {},
                        {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        }
                      ],
                      "description": "是否合并 Steam 客户端本地游玩记录（默认 false）。\n\n家庭共享游戏不会出现在 GetOwnedGames 中，但其时长记录在\n`userdata/<id>/config/localconfig.vdf`；启用后同步脚本会读取该文件，\n将额外游戏写入 `steam-local.json`，构建期与在线库合并展示。"
                    },
                    "request": {
                      "anyOf": [
                        {},
                        {
                          "type": "object",
                          "properties": {
                            "minDelayMs": {
                              "anyOf": [
                                {},
                                {
                                  "type": "number"
                                }
                              ]
                            },
                            "timeoutMs": {
                              "anyOf": [
                                {},
                                {
                                  "type": "number"
                                }
                              ]
                            }
                          },
                          "additionalProperties": false
                        }
                      ],
                      "description": "可选请求调优。"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "外部数据提供方。"
    },
    "snapshot": {
      "anyOf": [
        {},
        {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "description": "快照目录（相对项目根，默认 src/data/games-snapshots）"
            },
            "staleAfterDays": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "过期告警天数（仅日志提示，默认 30）"
            },
            "keepLastValid": {
              "type": "boolean",
              "description": "同步失败时是否保留上一次有效快照（默认 true）"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "快照存储策略。"
    },
    "title": {
      "anyOf": [
        {},
        {
          "type": "string"
        }
      ],
      "description": "页面标题：字面量（个人化、语言无关），或 \"$t:<i18nKey>\"（本地化；默认即当前词条）"
    },
    "description": {
      "anyOf": [
        {},
        {
          "type": "string"
        }
      ],
      "description": "页面副标题：同上"
    }
  },
  "additionalProperties": false
}
